{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Build OpenGL",
            "command": "gcc",
            "args": [
                "-g",
                "-std=c11",
                "-I${workspaceFolder}/include",
                "-L${workspaceFolder}/lib",
                "${workspaceFolder}/src/main.c",
                "${workspaceFolder}/src/glad.c",
                "-lglfw3",
                "-lopengl32",
                "-lgdi32",
                "-lwinmm",
                "-luser32",
                "-lshell32",
                "-o",
                "${workspaceFolder}/app.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
